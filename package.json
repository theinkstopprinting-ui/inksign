{
  "name": "inksign",
  "productName": "InkSign",
  "version": "1.5.0",
  "description": "InkSign - sign shop design, RIP & cut manager for The Ink Stop (Flexi-style design, cutters, HP Latex direct, Xerox print server)",
  "main": "electron/main.js",
  "author": "The Ink Stop Screen & Sign Printing, Inc.",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "dist": "vite build && electron-builder --win nsis",
    "dist:portable": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.theinkstop.inksign",
    "productName": "InkSign",
    "files": [
      "electron/**/*",
      "dist/index.html",
      "dist/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InkSign",
      "perMachine": false,
      "artifactName": "InkSign-Setup-${version}.exe"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.invalid/inksign"
      }
    ],
    "protocols": [
      {
        "name": "InkSign",
        "schemes": [
          "inksign"
        ]
      }
    ],
    "asarUnpack": [
      "electron/color/**",
      "electron/lib/gsWorker.js",
      "electron/printers/**",
      "node_modules/@jspawn/ghostscript-wasm/**",
      "node_modules/lcms-wasm/dist/*.wasm"
    ]
  },
  "dependencies": {
    "@jspawn/ghostscript-wasm": "^0.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-updater": "^6.8.9",
    "lcms-wasm": "^1.0.5",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "clipper-lib": "^6.4.2",
    "dxf-parser": "^1.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svgpath": "^2.6.0",
    "vite": "^8.3.4"
  }
}
